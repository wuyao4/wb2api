{
  "name": "workbuddy2api",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Multi-channel OpenAI / Anthropic compatible gateway: WorkBuddy plus any OpenAI-compatible upstream",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "test": "node scripts/smoke-test.mjs && node scripts/connect-test.mjs && node scripts/clipboard-test.mjs && node scripts/oauth-test.mjs && node scripts/qr-test.mjs && node scripts/account-test.mjs && node scripts/e2e-oauth-test.mjs && node scripts/boot-test.mjs",
    "test:connect": "node scripts/connect-test.mjs",
    "test:clipboard": "node scripts/clipboard-test.mjs",
    "test:oauth": "node scripts/oauth-test.mjs",
    "test:qr": "node scripts/qr-test.mjs",
    "test:account": "node scripts/account-test.mjs",
    "test:e2e": "node scripts/e2e-oauth-test.mjs",
    "test:boot": "node scripts/boot-test.mjs",
    "test:live-auth": "node scripts/live-auth.mjs",
    "test:live": "node scripts/live-connect.mjs",
    "test:ui": "node scripts/ui-smoke-test.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "check": "node scripts/check.mjs",
    "refresh": "node bin/refresh.js",
    "setup": "node bin/setup.js",
    "login": "node tools/wb-login.mjs"
  },
  "engines": {
    "node": ">=18"
  }
}
